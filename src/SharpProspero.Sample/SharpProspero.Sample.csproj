<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Prospero.App.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpProspero.Sample</RootNamespace>
    <AssemblyName>SharpProspero.Sample</AssemblyName>

    <!-- The module lands in the package as eboot.bin. -->
    <ProsperoModuleName>eboot.bin</ProsperoModuleName>

    <!-- A small ceiling: this module draws a static scene and needs little heap. -->
    <ProsperoHeapHardLimitBytes>134217728</ProsperoHeapHardLimitBytes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpProspero\SharpProspero.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sce_sys\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\..\build\Prospero.App.targets" />

</Project>
