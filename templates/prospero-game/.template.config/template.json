{
  "$schema": "http://json.schemastore.org/template",
  "author": "SvenGDK",
  "classifications": [ "Prospero", "Homebrew", "Console", "AOT", "Game" ],
  "identity": "SharpProspero.Game.CSharp",
  "name": "SharpProspero Game",
  "shortName": "prospero-game",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "SampleApp",
  "preferNameDirectory": true,
  "symbols": {
    "title": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "My Game",
      "replaces": "APP_TITLE",
      "description": "The display title shown for the game."
    },
    "titleId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "PPSA99099",
      "replaces": "APP_TITLEID",
      "description": "The nine-character title id."
    },
    "conceptId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "99099",
      "replaces": "APP_CONCEPTID",
      "description": "The concept id."
    },
    "contentIdOverride": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "A whole 36-character content id, when the derived one is not what is wanted."
    },
    "contentIdDerived": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "UP9000-" },
          { "type": "ref", "value": "titleId" },
          { "type": "const", "value": "_00-PROSPERO00000000" }
        ]
      }
    },
    "contentId": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "contentIdOverride",
        "fallbackVariableName": "contentIdDerived"
      },
      "replaces": "APP_CONTENTID"
    }
  },
  "primaryOutputs": [
    { "path": "SampleApp.csproj" }
  ]
}
